generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  progress  ReadingProgress[]
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  ebookId   String
  page      Int      @default(1)
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, ebookId])
}

model Folder {
  id        String     @id @default(cuid())
  name      String
  color     String     @default("#FFD166")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  notebooks Notebook[]
}

model Notebook {
  id          String         @id @default(cuid())
  title       String
  coverColor  String         @default("#EF476F")
  folderId    String?
  template    String         @default("Blank")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  folder      Folder?        @relation(fields: [folderId], references: [id])
  pages       NotebookPage[]
}

model NotebookPage {
  id         String   @id @default(cuid())
  notebookId String
  pageNumber Int
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  @@unique([notebookId, pageNumber])
}
